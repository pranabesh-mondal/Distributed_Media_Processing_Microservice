# ---------------------------------------------------------------------------
# Distributed Media Processing Microservice - Environment Variables
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# ---------------------------------------------------------------------------

# ---- Application ----------------------------------------------------------
APP_NAME=Distributed Media Processing Microservice
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ---- AWS / S3 -------------------------------------------------------------
# Leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty to fall back to the
# standard AWS credential chain (IAM role, ~/.aws/credentials, etc.).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-media-bucket-name
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net
# Validity of pre-signed S3 URLs, in seconds.
S3_PRESIGNED_URL_EXPIRY=3600
# Optional custom S3 endpoint (e.g. http://localhost:4566 for LocalStack).
S3_ENDPOINT_URL=

# ---- Redis ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30
# How long job records live in Redis (seconds) before automatic cleanup.
REDIS_JOB_TTL=86400

# ---- Celery / RabbitMQ ----------------------------------------------------
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_QUEUE=media
CELERY_RESULT_EXPIRES=3600

# ---- Retry / network-failure handling -------------------------------------
DEFAULT_MAX_RETRIES=3
RETRY_BACKOFF=1.0
RETRY_BACKOFF_MAX=60.0
WORKER_MAX_RETRIES=5
WORKER_RETRY_BACKOFF=5
WORKER_RETRY_BACKOFF_MAX=300
